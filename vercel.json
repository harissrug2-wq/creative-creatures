{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/email-status",
      "destination": "/api/email-report?mode=status"
    },
    {
      "source": "/api/email-status/",
      "destination": "/api/email-report?mode=status"
    },
    {
      "source": "/owner-archetype/assessment/",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/owner-archetype/assessment",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/owner-archetype/processing/",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/owner-archetype/processing",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy/"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy-policy/"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service/"
    },
    {
      "source": "/terms",
      "destination": "/terms-of-service/"
    },
    {
      "source": "/terms/",
      "destination": "/terms-of-service/"
    },
    {
      "source": "/integrations/jira/callback",
      "destination": "/integrations/jira/callback/"
    }
  ],
  "functions": {
    "api/financial-evidence.js": {
      "maxDuration": 60
    }
  }
}
