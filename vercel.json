{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/leadership-calendar-sync",
      "destination": "/api/leadership?cron=calendar"
    },
    {
      "source": "/api/crm-oauth",
      "destination": "/api/account-auth"
    },
    {
      "source": "/api/crm-oauth/",
      "destination": "/api/account-auth"
    },
    {
      "source": "/api/email-status",
      "destination": "/api/email-report?mode=status"
    },
    {
      "source": "/api/email-status/",
      "destination": "/api/email-report?mode=status"
    },
    {
      "source": "/owner-archetype/assessment/",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/owner-archetype/assessment",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/owner-archetype/processing/",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/owner-archetype/processing",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/owner-archetype/report/:token/",
      "destination": "/owner-archetype/"
    },
    {
      "source": "/owner-archetype/report/:token",
      "destination": "/owner-archetype/"
    }
  ],
  "functions": {
    "api/financial-evidence.js": {
      "maxDuration": 60
    },
    "api/leadership.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/leadership-calendar-sync",
      "schedule": "15 2 * * *"
    }
  ]
}
