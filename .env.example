SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Transactional email (Resend) — server-side only
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=Creative Creatures <reports@YOUR_VERIFIED_DOMAIN.com>
# Backwards-compatible report sender. RESEND_FROM_EMAIL takes precedence.
REPORT_FROM_EMAIL=Creative Creatures Reports <reports@YOUR_VERIFIED_DOMAIN.com>
# Optional
EMAIL_REPLY_TO=support@YOUR_VERIFIED_DOMAIN.com

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ACCOUNT_SESSION_SECRET=
# ADMIN_PASSWORD, ADMIN_SESSION_SECRET, ACCOUNT_SESSION_SECRET must be stored as sensitive server-side values.

# QuickBooks Online OAuth (server-side only)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://app.creativecreatures.org/integrations/quickbooks/callback/
QUICKBOOKS_ENVIRONMENT=sandbox
# Optional dedicated encryption secret. If omitted, ACCOUNT_SESSION_SECRET is used.
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=
# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://app.creativecreatures.org/integrations/google-calendar/callback/
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Google Drive OAuth + Picker
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://app.creativecreatures.org/integrations/google-drive/callback/
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_PROJECT_NUMBER=

# HubSpot OAuth (2026-03)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://app.creativecreatures.org/integrations/hubspot/callback/
HUBSPOT_TOKEN_ENCRYPTION_KEY=
